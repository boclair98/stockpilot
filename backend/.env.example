# Copy to .env (gitignored) for `docker compose up`.

# Pre-baked UUID treated as the signed-in user for any X-Coders-User-less
# request — only used in local dev (the platform gate stamps the header
# in prod). Generate your own with `python -c "import uuid; print(uuid.uuid4())"`.
DEV_FAKE_USER=00000000-0000-0000-0000-000000000001

# Backend listens on 0.0.0.0:8000; compose maps that to localhost:8000.
DATABASE_URL=postgresql+asyncpg://app:app@db:5432/app

# KIS is used only for market data. No brokerage account number or password is
# needed because StockPilot executes orders in its own virtual ledger.
KIS_ENV=paper
KIS_APP_KEY=
KIS_APP_SECRET=
SIMULATION_FEE_RATE=0.00015
SIMULATION_KR_SELL_TAX_RATE=0.002

# Financial Supervisory Service OpenDART authentication key (40 characters).
DART_API_KEY=

# Google Auth Platform > Clients > Web application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://stockpilot.coders.kr/api/auth/google/callback

# Generate at least 32 random bytes. Never commit or expose this value.
AUTH_SESSION_SECRET=
AUTH_COOKIE_SECURE=true
FIREBASE_SERVICE_ACCOUNT_B64=
