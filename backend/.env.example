# Copy to .env (gitignored) for `docker compose up`.

# Pre-baked UUID treated as the signed-in user for any X-Coders-User-less
# request — only used in local dev (the platform gate stamps the header
# in prod). Generate your own with `python -c "import uuid; print(uuid.uuid4())"`.
DEV_FAKE_USER=00000000-0000-0000-0000-000000000001

# Backend listens on 0.0.0.0:8000; compose maps that to localhost:8000.
DATABASE_URL=postgresql+asyncpg://app:app@db:5432/app
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=15
DATABASE_POOL_RECYCLE=900
REDIS_URL=redis://cache:6379/0
LEADERBOARD_CACHE_SECONDS=15
RATE_LIMIT_READ_PER_MINUTE=240
RATE_LIMIT_WRITE_PER_MINUTE=30
MAX_REQUEST_BODY_BYTES=64000

# logo.dev Dashboard > API Keys > Publishable key (pk_...). When configured,
# every searched Korean/US ticker receives a CDN-backed company logo URL.
LOGO_DEV_PUBLISHABLE_KEY=

# KIS is used only for market data. No brokerage account number or password is
# needed because StockPilot executes orders in its own virtual ledger.
KIS_ENV=paper
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_REST_CALLS_PER_SECOND=1
MARKET_DATA_REQUEST_TIMEOUT_SECONDS=8
SIMULATION_FEE_RATE=0.00015
SIMULATION_KR_SELL_TAX_RATE=0.002
TRADING_MODE=SIMULATION
MARKET_DATA_MAX_AGE_SECONDS=15
RISK_MAX_ORDER_NOTIONAL_KRW=100000000
RISK_MAX_ORDER_NOTIONAL_USD=100000
RISK_MAX_OPEN_ORDERS=20
RISK_MAX_DAILY_ORDERS=200
RISK_MAX_PRICE_DEVIATION_PERCENT=30

# Comma-separated Google login emails for /operations. Keep private.
OPERATOR_EMAILS=

# Financial Supervisory Service OpenDART authentication key (40 characters).
DART_API_KEY=

# Google Auth Platform > Clients > Web application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://stockpilot.coders.kr/api/auth/google/callback

# Generate at least 32 random bytes. Never commit or expose this value.
AUTH_SESSION_SECRET=
AUTH_COOKIE_SECURE=true
ENABLE_API_DOCS=false
RUN_MIGRATIONS_ON_BOOT=true
FIREBASE_SERVICE_ACCOUNT_B64=

